# 이 파일을 같은 폴더에 application.properties 로 복사해 쓴다(git 제외). 값은 디스코드의 최신 application.properties 를 받는다.
# 키를 추가하거나 바꾸면 이 예시 파일도 같은 PR에서 고치고, 디스코드의 파일도 갱신한다.
# 도메인별 구획 안에 추가한다. 맨 끝에 붙이면 병합할 때 충돌한다. 비밀값은 이 예시 파일에 쓰지 않는다.

# 공통
spring.application.name=nyangmeong-backend
spring.profiles.default=local
spring.mvc.format.date=iso
spring.mvc.format.date-time=iso
mybatis.mapper-locations=classpath:mapper/**/*.xml
logging.level.com.nyangmeong=debug

# 공용 DB(비밀값, 디스코드로 받는다)
spring.datasource.url=
spring.datasource.username=
spring.datasource.password=

# 보안(비밀값, 디스코드로 받는다). Base64 값이며 AES는 32바이트, HMAC·JWT는 32바이트 이상. 없으면 서버가 뜨지 않는다
app.crypto.aes-key-base64=
app.crypto.hmac-key-base64=
app.jwt.secret-base64=
# 만료(밀리초). 생략하면 Access 30분, Refresh 1일
app.jwt.access-token-expiry-ms=1800000
app.jwt.refresh-token-expiry-ms=86400000
# 쿠키 Secure 플래그. 운영(HTTPS)만 true
app.cookie.secure=false
# 쿠키를 실어 보낼 수 있는 프론트 오리진(쉼표 구분). 개발은 Vite 주소
app.cors.allowed-origins=http://localhost:5173
# 로그인 없이 여는 경로(쉼표 구분). 목록 밖은 전부 인증이 필요하다. 생략하면 아래와 같은 기본값
app.security.permit-all-paths=/api/auth/dev-tokens,/api/auth/login,/api/auth/sns-login,/api/auth/login-attempt-limits,/api/auth/captchas,/api/auth/refresh,/api/auth/logout,/api/terms,/api/terms/*,/api/email-certifications,/api/email-certifications/*/verify,/api/email-certifications/*/invalidate,/api/email-certifications/*/password-reset,/api/members,/api/members/nickname-availability,/api/members/phone-availability,/api/members/recovery-info,/api/members/recovery,/api/members/me/nickname,/api/files/public/**,/swagger-ui/**,/swagger-ui.html,/v3/api-docs/**,/internal/ai/tools

# 이메일 인증·가입(SCR-ACC-001). 모두 생략 가능, 생략하면 아래와 같은 기본값(초·분 단위는 키 이름 끝)
app.email-cert.code-validity-seconds=180
app.email-cert.resend-interval-seconds=60
app.email-cert.resend-window-minutes=60
app.email-cert.resend-max-count=5
app.email-cert.verified-keep-minutes=30
app.email-cert.fail-limit=5
app.signup.nickname-token-valid-minutes=30
app.signup.sns-token-valid-minutes=30

# 메일 발송. 이 줄이 없거나 log 면 보내지 않고 로그만 남긴다(받는 사람에게 실제로 나가지 않는다). 실제 발송은 smtp (아래 spring.mail 계정 필요, 계정은 디스코드 파일)
app.mail.client=log
app.mail.from=
app.mail.from-name=냥멍케어
spring.mail.host=
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# SNS 로그인. 이 줄이 없으면 실제 호출(real, 앱 키 필요)이다. 로컬에서 앱 키 없이 확인할 때만 fake 로 두고 code 를 fake-이름 으로 보낸다. 배포 서버에는 fake 를 두지 않는다
# redirect-uri 는 비워 두면 app.front-base-url + /login/sns/{naver|kakao|google}/callback 이다. 환경마다 app.front-base-url 만 바꾸고, 그 주소를 제공자 콘솔에도 등록한다
app.sns.client=fake
app.sns.timeout-ms=3000
app.sns.naver.client-id=
app.sns.naver.client-secret=
app.sns.naver.redirect-uri=
app.sns.kakao.client-id=
app.sns.kakao.client-secret=
app.sns.kakao.redirect-uri=
app.sns.google.client-id=
app.sns.google.client-secret=
app.sns.google.redirect-uri=

# 파일 저장(SCR-MYP-010). 저장 루트 폴더. 비우면 OS별 기본 경로: Windows는 프로젝트가 있는 드라이브 루트 아래 home/ggorilab/attachment, Mac은 /Users/Shared/ggorilab/attachment
# 그 밖의 OS와 prod는 반드시 적는다(운영은 application-prod.properties). 개인 PC 경로는 커밋하지 않는다. 업로드 상한은 SYS_STNG.FILE_MAX_SZ(10MB)와 맞춘다
# app.file.root-dir=
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=100MB
# 로그 파일 폴더(logback-spring.xml). 비우면 파일 저장 루트와 같은 규칙: Windows는 프로젝트 드라이브 루트 아래 home/ggorilab/logs, Mac은 /Users/Shared/ggorilab/logs
# 그 밖의 OS와 prod는 반드시 적는다(운영은 application-prod.properties에 /home/ggorilab/logs)
# app.log.dir=
# 캐릭터 생성기. 외부 API가 정해지기 전에는 fake(가짜 성공), 실패 시험은 fake-fail
app.character.generator=fake
# 목격 장소·돌봄 장소 좌표 → 행정구역 변환(SCR-CMU-002·004). 기본 fake(좌표와 무관하게 전주시), 시험은 fake-outside(전북 밖)·fake-none(찾지 못함), 실제 변환은 kakao(app.kakao-local.rest-api-key를 같이 씀. 카카오가 실패하면 502)
app.region.client=fake
# 장소 검색(SCR-HOS-001). 카카오 로컬 API 키를 받기 전에는 fake(전주 고정 업체), 연결하면 kakao. 키는 REST API 키(디스코드 파일에만 적음)
app.kakao-local.client=fake
app.kakao-local.rest-api-key=
app.kakao-local.timeout-ms=3000

# 프론트 주소. 알림 메일(SCR-AIM-006) 본문 링크와 SNS 로그인 콜백 주소에 쓴다. 생략하면 아래와 같은 기본값, 배포 서버는 배포 프론트 주소
app.front-base-url=http://localhost:5173

# 케어미션 정산·출제 배치(SCR-MYP-020). 생략하면 false(꺼짐). 배포는 application-prod.properties가 켠다
# 로컬에서는 공용 DB에 미션을 만들어 확인할 때만 아래 주석을 풀고, 확인이 끝나면 다시 지운다(켠 PC마다 매시 정각에 공용 DB에 씀)
# app.care-mission.batch-enabled=true

# 펫뉴스 수집(SCR-CMU-003). 검색 RSS 주소·검색어(OR로 연결)·기사 사이 대기(ms)·요청 제한 시간(ms). 생략하면 아래와 같은 기본값
app.news.rss-url=https://news.google.com/rss/search
app.news.query=반려동물 OR 반려견 OR 반려묘 OR 강아지 OR 고양이
app.news.request-interval-ms=1000
app.news.timeout-ms=5000
# 뉴스 수집 배치(매일 06시·18시). 생략하면 false(꺼짐). 배포는 application-prod.properties가 켠다
# 로컬에서는 공용 DB에 기사를 쌓아 확인할 때만 아래 주석을 풀고, 확인이 끝나면 다시 지운다. 관리자 수동 실행(POST /api/admin/batches/SYSC0028/run)도 켜 있어야 한다
# app.news.batch-enabled=true

# DMS MCP 서버 주소. setup이 읽어 AI 도구에 등록한다. claude.ai dms 커넥터가 연결돼 있으면 비워도 된다
dms.mcp-url=
